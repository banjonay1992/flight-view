// Copy to Secrets.xcconfig (git-ignored) and fill in.
// xcconfig treats "//" as a comment, so URLs use the $() trick: https:/$()/example.com
FV_API_BASE_URL = https:/$()/flightview-api.YOUR-SUBDOMAIN.workers.dev
FV_SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
// The anon (publishable) key is safe to ship in the app: access is enforced by Row Level Security.
FV_SUPABASE_ANON_KEY = YOUR-SUPABASE-ANON-KEY
